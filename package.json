{
  "name": "scrollfilm",
  "version": "0.1.0",
  "description": "Scroll-scrubbed video for the web: H.264 decoded with WebCodecs around the playhead, drawn with WebGL, smooth on low-end phones.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./encoder": "./src/encoder/encode.js"
  },
  "bin": {
    "scrollfilm": "bin/scrollfilm.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo:film": "node scripts/demo-film.js",
    "demo": "node scripts/serve.js demo",
    "test:browser": "node scripts/browser-test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "scroll",
    "scrollytelling",
    "video",
    "scrub",
    "webcodecs",
    "webgl",
    "h264",
    "image-sequence"
  ],
  "author": "Luciano Nery <luciano@lucianonery.dev> (https://lucianonery.dev)",
  "license": "MIT",
  "homepage": "https://git.lucianonery.dev/LucianoNeryDev/scrollfilm",
  "repository": {
    "type": "git",
    "url": "git+https://git.lucianonery.dev/LucianoNeryDev/scrollfilm.git"
  },
  "bugs": "https://git.lucianonery.dev/LucianoNeryDev/scrollfilm/issues",
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
